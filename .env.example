# ════════════════════════════════════════════════════════════════
#  AD Manager – Environment Variables Reference
#  Copy to .env and fill in your real values.
#  For Render: add each variable in Dashboard → Environment.
# ════════════════════════════════════════════════════════════════

# ─── Dev Mode (bypass LDAP — perfect for Render initial deploy) ───────────────
# DEV_MODE=true  → no LDAP needed, login with DEV_USERNAME/DEV_PASSWORD
# DEV_MODE=false → real LDAP required (default)
DEV_MODE=true
DEV_USERNAME=superuser
DEV_PASSWORD=Admin@1234

# ─── PostgreSQL / Supabase ────────────────────────────────────
# Format: jdbc:postgresql://<host>:<port>/<database>?sslmode=require
# Supabase example (sslmode=require is mandatory for Supabase):
DATABASE_URL=jdbc:postgresql://db.eisgluyonwpnbstygjmj.supabase.co:5432/postgres?sslmode=require
POSTGRES_USER=postgres
POSTGRES_PASSWORD=YOUR_SUPABASE_DB_PASSWORD

# Local PostgreSQL (Docker Compose dev):
# DATABASE_URL=jdbc:postgresql://postgres:5432/admanagerdb
# POSTGRES_USER=admanager
# POSTGRES_PASSWORD=AdManager@1234

# ─── JWT ──────────────────────────────────────────────────────
# Generate a strong secret: openssl rand -base64 64
JWT_SECRET=YWRtYW5hZ2Vyc2VjcmV0a2V5Zm9yanNvbndlYnRva2VuMzI=
JWT_EXPIRATION_MS=86400000

# ─── LDAP (OpenLDAP / external AD) ───────────────────────────
# For Render: host must be a publicly reachable IP/hostname on port 636
# (Render supports outbound TCP to external hosts)
LDAP_HOST=YOUR_LDAP_HOST_OR_IP
LDAP_PORT=636
LDAP_BIND_DN=cn=admin,dc=admanager,dc=local
LDAP_BIND_PASSWORD=Admin@1234
LDAP_BASE_DN=dc=admanager,dc=local

# ─── Spring Boot ──────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

# ─── pgAdmin (local dev only – not needed on Render) ──────────
PGADMIN_EMAIL=admin@admanager.local
PGADMIN_PASSWORD=Admin@1234

# ─── Docker local LDAP bootstrap (local dev only) ─────────────
LDAP_ADMIN_PASSWORD=Admin@1234
LDAP_CONFIG_PASSWORD=Config@1234

# ════════════════════════════════════════════════════════════════
#  RENDER QUICK-COPY (paste into Render → Environment)
# ════════════════════════════════════════════════════════════════
# DATABASE_URL=jdbc:postgresql://db.eisgluyonwpnbstygjmj.supabase.co:5432/postgres?sslmode=require
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=<from Supabase Dashboard → Settings → Database>
# JWT_SECRET=<run: openssl rand -base64 64>
# JWT_EXPIRATION_MS=86400000
# LDAP_HOST=<your OpenLDAP VPS IP or managed LDAP host>
# LDAP_PORT=636
# LDAP_BIND_DN=cn=admin,dc=admanager,dc=local
# LDAP_BIND_PASSWORD=Admin@1234
# LDAP_BASE_DN=dc=admanager,dc=local
# SPRING_PROFILES_ACTIVE=prod
# SERVER_PORT=8080
